{
  "comments": {
    "blockComment": ["*", "*"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    {"open": "(", "close": ")"},
    {"open": "[", "close": "]"},
    {"open": "{", "close": "}"},
    {"open": "\"", "close": "\""}
  ],
  "surroundingPairs": [
    {"open": "(", "close": ")"},
    {"open": "[", "close": "]"},
    {"open": "{", "close": "}"},
    {"open": "\"", "close": "\""},
    {"open": "*", "close": "*"}
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(if|what-if|else|repeat\\s+.*\\s+times|repeat\\s+while)\\b.*$",
      "action": { "indent": "indent" }
    }
  ]
}
